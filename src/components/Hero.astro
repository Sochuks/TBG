---
import heroImage from "../assets/images/232175.jpg";
import HeroCard from "../components/HeroCard.astro";
---

<section class="relative overflow-hidden h-[60-vh]">
  <!-- Background image -->
  <img
    src={heroImage.src}
    alt="Catchy Background"
    class="absolute inset-0 w-full h-full object-cover"
  />

  <!-- Dark overlay -->
  <div class="absolute inset-0 bg-black opacity-60"></div>
  <!-- header-container -->
  <div class="container max-w-screen-xl mx-auto px-2"></div>
</section>
