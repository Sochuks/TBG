---
import heroImage from "../assets/images/hero-pic.jpg";
import HeroCard from "../components/HeroCard.astro";
import animatedLogo from "../assets/images/animated-hero.svg"; // Removed ?raw, assuming it's a file
---

<section class="relative overflow-hidden h-[80vh] flex items-center">
  <!-- Background image -->
  <img
    src={heroImage.src}
    alt="Catchy Background"
    class="absolute inset-0 w-full h-full object-cover"
  />

  <!-- Dark overlay -->
  <div class="absolute inset-0 bg-gradient-to-r from-white to-white/0"></div>

  <!-- header-container -->
  <div class="container max-w-screen-xl mx-auto px-2 relative z-10 pt-16">
    <!-- Grid Container -->
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3 lg:gap-8 items-center">
      <!-- Left Column (Content) -->
      <div class="lg:col-span-2 p-6">
        <!-- <h1 class="text-3xl font-extrabold sm:text-5xl text-warm-beige">
          Let us find your
          <strong class="block font-extrabold text-sunset-orange">
            Forever Home.
          </strong>
        </h1> -->
        <h1
          class="bg-gradient-to-r from-golden-glow via-sunset-orange to-midnight-blue bg-clip-text text-3xl leading-tight font-extrabold text-transparent sm:text-5xl"
        >
          Unapologetically Black,

          <span class="sm:block">Stylish & Unstoppable! </span>
        </h1>

        <p class="mt-4 max-w-lg sm:text-xl/relaxed text-midnight-blue">
          Step into a world where culture, style, and lifestyle collide. From
          fashion to food, top spots in Abuja, and exclusive reviews—this is
          your front-row seat to the extraordinary.
        </p>

        <div class="mt-8 flex flex-wrap gap-4 text-center">
          <a
            href="#"
            class="block w-full rounded-lg bg-sunset-orange px-12 py-3 text-base font-medium text-white shadow-sm hover:bg-orange-600/70 focus:ring-3 focus:outline-none sm:w-auto"
          >
            Start Exploring
          </a>

          <a
            href="#"
            class="block w-full rounded-lg bg-deep-olive px-12 py-3 text-base font-medium text-white shadow-sm hover:bg-green-950/40 focus:ring-3 focus:outline-none sm:w-auto"
          >
            Join the Tribe
          </a>
        </div>
      </div>

      <!-- Right Column (SVG) -->
      <div
        class="h-32 rounded-lg bg-transparent flex items-center justify-center"
      >
      </div>
    </div>
  </div>
</section>

<style>
  .draw-path {
    stroke: url(#brandGradient);
    stroke-width: 2;
    fill: none;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    animation: draw 4s linear forwards;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
