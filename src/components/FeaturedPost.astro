---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../utils/utils";

const { post } = Astro.props;

interface Props {
  post: CollectionEntry<"blog">;
}
---

<article class="group cursor-pointer">
  <img
    alt=""
    src={post.data.image}
    class="h-72 w-full rounded-xl object-cover shadow-xl transition group-hover:grayscale-[50%]"
  />

  <div class="p-4 mt-4">
    <div>
      <span class="text-md text-deep-olive subtitle">{post.data.category}</span>
    </div>
    <a href={"/TBG/blog/" + post.slug}>
      <h3 class="font-medium text-midnight-blue">
        {post.data.title}
      </h3>
    </a>
    <div>
      <time datetime="2022-10-10" class="block text-sm text-gray-500">
        {formatDate(post.data.pubDate)}
      </time>
    </div>

    <p class="mt-2 line-clamp-3 text-sm/relaxed text-gray-500">
      {post.data.excerpt}
    </p>

    <div class="mt-4 flex flex-wrap gap-1">
      {
        post.data.tags.map((item) => (
          <span class="rounded-full border border-sunset-orange px-2.5 py-0.5 text-xs whitespace-nowrap text-sunset-orange">
            {item}
          </span>
        ))
      }
    </div>
  </div>
</article>
