---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../utils/utils";

const { post } = Astro.props;

interface Props {
  post: CollectionEntry<"blog">;
}
---

<article class="flex item-center space-y-4 group">
  <a href={"/TBG/blog/" + post.slug} class="inline-block mr-3">
    <div
      class="w-40 h-40 bg-cover bg-center"
      style=`background-image:url(${post.data.image});`
    >
    </div>
  </a>
  <div class="flex flex-col justify-center space-y-2">
    <time datetime="2022-10-10" class="block text-xs text-gray-500">
      {formatDate(post.data.pubDate)}
    </time>
    <h4
      class="text-[18px] text-gray-900 font-bold hover:text-indigo-600 leading-none"
    >
      {post.data.title}
    </h4>
    <span class="line-clamp-3 text-base text-gray-700">
      {post.data.excerpt}
    </span>
    <a
      href={"/TBG/blog/" + post.slug}
      class="group inline-flex items-center gap-1 text-sm font-medium text-deep-olive"
    >
      Read More

      <span
        aria-hidden="true"
        class="block transition-all group-hover:ms-0.5 rtl:rotate-180"
      >
        &rarr;
      </span>
    </a>
  </div>
</article>
