---
const { spot } = Astro.props;
---

<article
  class="rounded-lg border border-gray-100 bg-white p-4 shadow-xs transition hover:shadow-lg sm:p-6"
>
  <div class="flex flex-wrap gap-1 items-center py-1">
    <span class="inline-block text-white">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-6 text-gray-500"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
        ></path>
      </svg>
    </span>
    <span class="text-gray-500 text-xs">
      <a
        href={`https://www.google.com/maps/search/?q=${encodeURIComponent(spot.address)}`}
        target="_blank"
        rel="noopener noreferrer"
        style="font-size: 14px;"
      >
        {spot.address}
      </a></span
    >
  </div>

  <a href="#">
    <h4 class="text-[18px] text-midnight-blue font-bold hover:text-indigo-600">
      {spot.name}
    </h4>
  </a>
  <div class="mt-4 flex flex-wrap gap-1">
    {
      Array.isArray(spot?.tags) && spot.tags.length > 0 ? (
        spot.tags
          .slice(0, 3)
          .map((tag: string) => (
            <span class="rounded-full bg-deep-olive px-2.5 py-0.5 text-xs whitespace-nowrap text-white">
              {tag}
            </span>
          ))
      ) : (
        <span class="text-gray-500 text-xs">No tags available</span>
      )
    }
  </div>

  <span class="mt-2 line-clamp-2 text-base text-gray-500">
    {spot.description}
  </span>

  <a
    href={`https://www.google.com/maps/search/?q=${encodeURIComponent(spot.address)}`}
    target="_blank"
    rel="noopener noreferrer"
    class="group mt-4 inline-flex items-center gap-1 text-sm font-medium text-deep-olive"
  >
    Get Directions

    <span
      aria-hidden="true"
      class="block transition-all group-hover:ms-0.5 rtl:rotate-180"
    >
      &rarr;
    </span>
  </a>
</article>
