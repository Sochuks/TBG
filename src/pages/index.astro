---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import HomeProduct from "../components/HomeProduct";
import { store } from "../utils/db";
import AnimatedLogo from "../assets/images/animated-hero.svg?raw";
import FeaturedPost from "../components/FeaturedPost.astro";
import SamplePost from "../components/SamplePost.astro";

// get products
// const response = await fetch(`${Astro.url.origin}/api/products.json`);
// const { products } = await response.json();
const products = store;

// check products
if (!products) {
  console.log("Products not found");
  return new Response(null, {
    status: 404,
    statusText: "Not found",
  });
}
---

<Layout title="Home - That Black Girl Blog">
  <Hero />

  <section class="max-w-screen-xl mx-auto py-20 relative mb-24">
    <!-- Heading -->

    <div
      class="border-b border-b-golden-glow mb-5 flex justify-between text-sm"
    >
      <div
        class="text-midnight-blue flex items-center pb-2 pr-2 border-b-4 border-sunset-orange uppercase"
      >
        <h3 class="font-semibold inline-block">Top Trends</h3>
      </div>
      <a href="#">See All</a>
    </div>

    <!-- container -->
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-8">
      <div class="h-full">
        <FeaturedPost />
      </div>

      <div class="h-full px-4 py-4 space-y-2 bg-warm-beige">
        <SamplePost />
        <SamplePost />
        <SamplePost />
      </div>
    </div>
  </section>
</Layout>
