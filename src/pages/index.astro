---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import HomeProduct from "../components/HomeProduct";
import { store, places, events } from "../utils/db";
import AnimatedLogo from "../assets/images/animated-hero.svg?raw";
import FeaturedPost from "../components/FeaturedPost.astro";
import SamplePost from "../components/SamplePost.astro";
import SpotCard from "../components/SpotCard.astro";
import SectionTitle from "../components/SectionTitle.astro";
import EventCard from "../components/EventCard.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { CollectionKey } from "astro:content";

const allPost: CollectionEntry<"blog">[] = (await getCollection("blog")).sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const mostRecent: CollectionEntry<"blog"> = allPost[0];
const otherBlogs: CollectionEntry<"blog">[] = allPost.slice(1);

const spots = places;

const featuredPlace = spots.filter((place) => place.featured);

// Shuffle other places
function shuffleArray(array: any) {
  let shuffledArray = [...array];
  for (let i = shuffledArray.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffledArray[i], shuffledArray[j]] = [shuffledArray[j], shuffledArray[i]];
  }
  return shuffledArray;
}

const otherPlaces = shuffleArray(places.filter((place) => !place.featured));

// get products
// const response = await fetch(`${Astro.url.origin}/api/products.json`);
// const { products } = await response.json();
const products = store;

// check products
if (!products) {
  console.log("Products not found");
  return new Response(null, {
    status: 404,
    statusText: "Not found",
  });
}

const event = events;
const featuredEvent = event.filter((event) => event.isFeatured);
const upComing = event.filter((event) => event.isUpcoming);
---

<Layout title="Home - That Black Girl Blog">
  <Hero />

  <section class="max-w-screen-xl mx-auto py-20 relative">
    <!-- Heading -->
    <div
      class="border-b border-b-golden-glow mb-5 flex justify-between text-sm"
    >
      <div
        class="text-midnight-blue flex items-center pb-2 pr-2 border-b-4 border-sunset-orange uppercase"
      >
        <h3 class="font-semibold inline-block">Top Trends</h3>
      </div>
      <a href="#">See All</a>
    </div>

    <!-- container -->
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-8">
      <div class="h-full">
        <FeaturedPost post={mostRecent} />
      </div>

      <div
        class="flex flex-col justify-center px-4 py-4 space-y-2 bg-warm-beige"
      >
        {otherBlogs.slice(0, 3).map((post) => <SamplePost post={post} />)}
      </div>
    </div>
  </section>

  <!-- Top Spots -->
  <section class="max-w-screen-xl mx-auto py-20 relative">
    <!-- Heading -->
    <SectionTitle title="Hot Spots" />
    <!-- Grid container -->
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 lg:gap-8">
      <div class="flex flex-col justify-center space-y-8">
        {otherPlaces.slice(0, 2).map((item) => <SpotCard spot={item} />)}
      </div>

      <div class="flex flex-col justify-center bg-warm-beige lg:col-span-2">
        {
          featuredPlace.map((place) => (
            <div class="rounded overflow-hidden flex flex-col max-w-xl mx-auto">
              <a href="#">
                <img
                  class="w-full"
                  src={place.img}
                  alt="Sunset in the mountains"
                />
              </a>
              <div class="relative -mt-16 px-10 pt-5 pb-16 bg-white m-10">
                <h3 class="font-medium text-midnight-blue hover:text-indigo-600 transition duration-500 ease-in-out mb-2">
                  {place.name}
                </h3>
                <p class="text-gray-500 text-sm line-clamp-3">
                  {place.description}
                </p>
                <p class="mt-5 text-gray-600 text-xs">
                  By
                  <a
                    href="#"
                    class="text-xs text-indigo-600 transition duration-500 ease-in-out"
                  >
                    Mehdi Ahmadi
                  </a>{" "}
                  | in{" "}
                  <a
                    href="#"
                    class="text-xs text-indigo-600 transition duration-500 ease-in-out"
                  >
                    Cooking
                  </a>
                  ,{" "}
                  <a
                    href="#"
                    class="text-xs text-indigo-600 transition duration-500 ease-in-out"
                  >
                    Recipe
                  </a>
                </p>
              </div>
            </div>
          ))
        }
      </div>
      <div class="flex flex-col justify-center space-y-8">
        {otherPlaces.slice(2, 4).map((item) => <SpotCard spot={item} />)}
      </div>
    </div>
  </section>

  <!-- Store -->
  <section class="max-w-screen-xl mx-auto py-20 relative space-y-8">
    <SectionTitle title="Glam Store" />

    <!-- Grid Container -->
    <div class="grid gap-4 md:grid-col-2 md:gap-6 xl:grid-cols-3">
      {
        products
          .slice(3)
          .map((product: any) => <HomeProduct product={product} client:load />)
      }
    </div>

    <div
      class="overflow-hidden bg-[url(https://images.unsplash.com/photo-1489987707025-afc232f7ea0f?q=80&w=2670&auto=format&fit=crop)] bg-cover bg-top bg-no-repeat my-40"
    >
      <div class="bg-black/50 p-8 md:p-12 lg:px-16 lg:py-24">
        <div class="text-center ltr:sm:text-left rtl:sm:text-right">
          <h2 class="text-2xl font-bold text-white sm:text-3xl md:text-5xl">
            Latest Shirts
          </h2>

          <p
            class="hidden max-w-lg text-white/90 md:mt-6 md:block md:text-lg md:leading-relaxed"
          >
            Lorem ipsum dolor, sit amet consectetur adipisicing elit. Inventore
            officia corporis quasi doloribus iure architecto quae voluptatum
            beatae excepturi dolores.
          </p>

          <div class="mt-4 sm:mt-8">
            <a
              href="#"
              class="inline-block rounded-full bg-indigo-600 px-12 py-3 text-sm font-medium text-white transition hover:bg-indigo-700 focus:ring-3 focus:ring-yellow-400 focus:outline-hidden"
            >
              Get Yours Today
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Events -->
  <section class="max-w-screen-xl mx-auto py-20 relative">
    <SectionTitle title="Events" />

    <!-- Grign Container -->
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3 lg:gap-8">
      <div class="rounded-lg bg-gray-200">
        {
          featuredEvent.map((item) => (
            <article class="relative overflow-hidden rounded-lg h-full shadow-sm transition hover:shadow-lg">
              <img
                alt=""
                src={item.image}
                class="absolute inset-0 h-full w-full object-cover"
              />

              <div class="relative bg-gradient-to-t from-gray-900/50 to-gray-900/80 pt-32 sm:pt-48 lg:pt-64">
                <div class="p-4 sm:p-6">
                  <time
                    datetime="2022-10-10"
                    class="block text-xs text-white/90"
                  >
                    {item.date}
                  </time>

                  <a href="#">
                    <h3 class="mt-0.5 text-lg text-white">{item.name}</h3>
                  </a>

                  <p class="mt-2 line-clamp-3 text-sm/relaxed text-white/95">
                    {item.description}
                  </p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <div class="col-span-2">
        <div class="flex gap-8">
          {upComing.slice(0, 2).map((item) => <EventCard event={item} />)}
        </div>
      </div>
    </div>
  </section>
</Layout>
